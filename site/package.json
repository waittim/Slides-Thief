{
  "name": "slides-thief-web",
  "version": "3.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build:schemas": "node scripts/build-schemas.mjs",
    "build": "npm run build:schemas && vinext build",
    "build:pages": "npm run build:schemas && vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test:components": "playwright test --config=playwright-ct.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test": "npm run typecheck && npm run build && GITHUB_PAGES_BASE=/ npm run build:pages && node --test tests/*.test.mjs ../analytics-policy/worker.test.mjs && npm run test:components && npm run test:e2e",
    "test:pages": "GITHUB_PAGES_BASE=/ npm run build:pages && node --test tests/static-pages.test.mjs",
    "benchmark:detection": "node scripts/evaluate-detection.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next --max-warnings=0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "heic-to": "^1.5.2",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "json-schema-to-typescript": "^15.0.4",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.12",
    "vite": "8.3.1"
  },
  "type": "module"
}
